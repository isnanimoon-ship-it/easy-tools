NEXT_PUBLIC_SITE_URL=https://www.konly.co.kr

# 선택: 카카오톡 직접 공유 버튼. Kakao Developers의 JavaScript 키와
# JavaScript SDK 도메인 및 Product Link 웹 도메인(www.konly.co.kr) 등록이 필요합니다.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# 도구 조회수 집계 / 인기 랭킹 위젯 (supabase/migrations 참고)
# URL과 anon key는 공개되어도 안전합니다(anon key는 tool_popularity 테이블 SELECT만 허용하는 RLS 정책이 걸려 있음).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key는 절대 NEXT_PUBLIC_ 접두사를 붙이지 말고, 서버 코드(Route Handler)에서만 사용하세요.
SUPABASE_SERVICE_ROLE_KEY=
